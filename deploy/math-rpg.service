[Unit]
Description=Matematica RPG (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=math-rpg
Group=math-rpg
WorkingDirectory=/opt/math-rpg
EnvironmentFile=/opt/math-rpg/.env
ExecStart=/opt/math-rpg/.venv/bin/gunicorn -c gunicorn.conf.py run:app
Restart=on-failure
RestartSec=5

# Basic sandboxing — tighten further per your host's threat model.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/math-rpg/instance /opt/math-rpg/backups

[Install]
WantedBy=multi-user.target
