__pycache__/
*.pyc
.venv/
.env
instance/
*.db
.pytest_cache/
backups/

# Raw art packs (source material, not the app's assets). Some carry
# no-redistribution license terms; the app only uses the curated,
# already-license-compliant copies under app/static/images/.
app/static/assets/

# Frontend build output — generated by `npm run build` (see package.json
# and README.md's "Assets locais" section), not source. node_modules is
# reinstalled from package-lock.json (which IS committed); the vendor
# copies and compiled CSS are regenerated fresh by copy-vendor-assets.js
# and the Tailwind CLI every install/update (see deploy/install.sh),
# so committing them would just be stale, easy-to-forget-to-refresh
# binary noise in every diff.
node_modules/
app/static/vendor/
app/static/css/tailwind.css

# Claude Code harness state, not part of the project.
.claude/
