{
  "name": "math-rpg-assets",
  "version": "1.0.0",
  "description": "Pipeline de build de assets (Tailwind CSS + fontes/ícones/htmx locais) do Matemática RPG — sem CDN em produção.",
  "scripts": {
    "copy:vendor": "node assets/copy-vendor-assets.js",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./app/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./app/static/css/tailwind.css --watch",
    "build": "npm run copy:vendor && npm run build:css"
  },
  "license": "ISC",
  "private": "true",
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/medievalsharp": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "htmx.org": "^1.9.12"
  }
}
